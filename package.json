{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy:maplibre-worker": "mkdir -p public/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/maplibre/",
    "predev": "npm run copy:maplibre-worker",
    "dev": "next dev",
    "prebuild": "npm run copy:maplibre-worker",
    "build": "next build",
    "start": "next start",
    "test": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:e2e": "playwright test",
    "perf": "node scripts/perf.mts"
  },
  "dependencies": {
    "maplibre-gl": "^6.5.0",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
